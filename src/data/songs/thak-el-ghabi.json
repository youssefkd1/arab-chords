            },
            {
              "name": "Verse",
              "lines": [
                {
                  "segments": [
                    { "chord": "D", "text": "Every time he passed " },
                    { "chord": "A", "text": "through my heart" }
                  ]
                },
                {
                  "segments": [
                    { "chord": "Bm", "text": "he left a mark " },
