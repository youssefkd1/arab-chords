                  ]
                },
                {
                  "segments": [
                    { "chord": "D", "text": "and now you cry " },
                    { "chord": "A", "text": "alone" }
                  ]
                },
                {
                  "segments": [
                    { "chord": "Bm", "text": "while I am far " },
                    { "chord": "G", "text": "from you" }
                  ]
                }
              ]
            },
