                  ]
                },
                {
                  "segments": [
                    { "chord": "Bm", "text": "and got lost " },
                    { "chord": "G", "text": "along the way" }
                  ]
                }
              ]
            },
            {
              "name": "Chorus",
              "lines": [
                {
                  "segments": [
                    { "chord": "D", "text": "Oh that fool, " },
                    { "chord": "A", "text": "I still remember" }
                  ]
                },
                {
                  "segments": [
                    { "chord": "Bm", "text": "how you used to " },
